{
  "name": "english-reader",
  "version": "1.0.0",
  "description": "AI English reading studio: discover or import articles, get evidence-backed sentence-level analysis, and grow a personal knowledge base.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "docs/*.md",
    "icon.svg",
    "lib/*.js",
    "lib/demo-library.json",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node tests/all.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+github.com:chenzhenhong/English-Reader.git"
  }
}
